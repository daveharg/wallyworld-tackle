# Shopify Storefront API credentials
# Get these from your Shopify Admin → Apps → Develop apps → your storefront app
# (Storefront API access token — NOT the Admin API token)

# Your store domain, e.g. ky0phv-a9.myshopify.com
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=

# Storefront API public access token
NEXT_PUBLIC_SHOPIFY_STOREFRONT_ACCESS_TOKEN=

# ─── Accounts & loyalty ──────────────────────────────────────────────
# See LOYALTY_SETUP.md for full setup instructions.

# Database connection.
# Development (SQLite file, zero setup): file:./dev.db
# Production (Vercel Postgres): paste your Postgres connection string here
#   and set provider = "postgresql" in prisma/schema.prisma
DATABASE_URL="file:./dev.db"

# NextAuth — required. Generate one with: openssl rand -base64 32
NEXTAUTH_SECRET=
# Public site URL (used for OAuth callbacks). Local dev: http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# Google OAuth ("Sign up with Gmail" button). Optional — the button is hidden
# until both are set. Create credentials in Google Cloud Console (see LOYALTY_SETUP.md).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Shared secret protecting the manual points-credit API (POST /api/points with
# adminKey). Optional; without it, only self-service earn is allowed.
POINTS_ADMIN_SECRET=
