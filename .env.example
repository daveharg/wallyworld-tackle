# Shopify Storefront API credentials
# Get these from your Shopify Admin → Apps → Develop apps → your storefront app
# (Storefront API access token — NOT the Admin API token)

# Your store domain, e.g. stillwater-bcusl52j.myshopify.com
NEXT_PUBLIC_SHOPIFY_STORE_DOMAIN=

# Storefront API public access token
NEXT_PUBLIC_SHOPIFY_STOREFRONT_ACCESS_TOKEN=
