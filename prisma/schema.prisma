// Wallyworld Tackle — accounts + loyalty database schema.
//
// Production database: Vercel Postgres (provider = "postgresql").
// Point DATABASE_URL at the Postgres connection string (or connect a Vercel
// Postgres store, which auto-provides POSTGRES_PRISMA_URL / POSTGRES_URL).
// NOTE: SQLite is NOT supported in production — Vercel's serverless
// filesystem is read-only and ephemeral, so a file-based DB silently breaks
// every auth/loyalty API route (this caused the Google sign-in blank screen).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String?
  passwordHash String? // null for Google-OAuth-only accounts
  googleId     String?  @unique // set when the account is linked to Google
  createdAt    DateTime @default(now())

  loyalty    LoyaltyPoints?
  pointsTx   PointsTransaction[]
  savedCart  SavedCart?
  addresses  Address[]
  orders     Order[]
  storeCredits StoreCredit[]
}

model LoyaltyPoints {
  userId          String   @id
  pointsBalance   Int      @default(0)
  lifetimePoints  Int      @default(0)
  updatedAt       DateTime @updatedAt
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PointsTransaction {
  id        String   @id @default(cuid())
  userId    String
  points    Int // positive = earned, negative = redeemed
  type      String // "earn" | "redeem" | "adjust"
  orderId   String?
  note      String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model SavedCart {
  userId    String   @id
  cartData  String // JSON array of CartItem (stored as text: valid on SQLite + Postgres)
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Address {
  id         String  @id @default(cuid())
  userId     String
  label      String  @default("Home")
  name       String
  address1   String
  address2   String?
  city       String
  province   String
  postalCode String
  country    String  @default("Canada")
  phone      String?
  isDefault  Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Order {
  id              String   @id @default(cuid())
  userId          String
  shopifyOrderId  String? // filled if/when we can read it back
  orderNumber     String?
  total           Float
  currency        String   @default("CAD")
  email           String?
  status          String   @default("pending") // pending | completed
  pointsCredited  Boolean  @default(false)
  createdAt       DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model StoreCredit {
  id        String   @id @default(cuid())
  userId    String
  code      String   @unique // e.g. WALLY-7X2K9Q
  amount    Float    // dollars off
  currency  String   @default("CAD")
  redeemed  Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
